discovery.docker "payops" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=payops"]
  }
}
discovery.relabel "payops" {
  targets = discovery.docker.payops.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    target_label = "job"
    replacement = "payops"
  }
}
loki.source.docker "payops" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.payops.output
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
